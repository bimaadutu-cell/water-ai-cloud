# WATER AI CLOUD — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:npg_Pc04fGODSsHR@ep-floral-water-adse9nfc-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Public URL of the app (used for links, origin checks, PWA)
APP_URL=http://localhost:3000

# Public URL of the REST API (same host by default)
API_URL=http://localhost:3000

# Secret used to sign tokens on the server side (min 32 chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: Redis for distributed rate limiting / queues (not required)
REDIS_URL=

# Optional: OpenAI-compatible API key for the AI Reply feature.
# Kept server-side only. Never exposed to the frontend.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Gemini (primary AI provider when GEMINI_API_KEY is set)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=60000

# Optional command sources (features degrade gracefully with an honest error
# message when a key is missing — nothing is faked):
TMDB_API_KEY=1ae110e6c988152ee842b46b77656d27
REMOVEBG_API_KEY=
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# Default signing secret used when a webhook has no custom secret
WEBHOOK_SECRET=

# Password for the initial admin account created by the seed script.
# Only printed to the terminal during seeding — never shown in the web UI.
ADMIN_INITIAL_PASSWORD=bimz123A

# Where bot auth state (WhatsApp credentials) and temporary media are stored on disk.
# Use a persistent volume in production so linked sessions survive restarts.
STORAGE_CONFIG=./data

# Real yt-dlp executable. Docker installs /usr/local/bin/yt-dlp and Python 3.
YTDLP_PATH=/usr/local/bin/yt-dlp
# Optional override; Docker uses /usr/bin/ffmpeg by default.
FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: URL of a Cobalt instance you own/manage for sites that reject yt-dlp.
# Do not use an unknown public instance without permission. Leave empty to use yt-dlp only.
COBALT_API_URL=
